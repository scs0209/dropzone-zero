{
  "name": "dropzone-zero",
  "version": "0.0.0",
  "description": "A local agent that keeps your Downloads folder tidy, with every move reversible.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "dz": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.2"
  },
  "scripts": {
    "dz": "node --import tsx src/cli.ts",
    "seed": "node --import tsx scripts/seed-demo.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@sentry/node": "11.4.0",
    "unpdf": "1.8.1"
  }
}
