{
  "name": "dropzone-zero",
  "version": "0.0.0",
  "description": "A local agent that keeps your Downloads folder tidy, with every move reversible.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "dz": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dz": "node --import tsx src/cli.ts",
    "seed": "node --import tsx scripts/seed-demo.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "seed:history": "node --import tsx scripts/seed-history.ts",
    "app": "node scripts/vendor-three.mjs && tauri dev --config app/src-tauri/tauri.conf.json",
    "app:build": "node scripts/vendor-three.mjs && tauri build --config app/src-tauri/tauri.conf.json",
    "app:vendor": "node scripts/vendor-three.mjs",
    "eval:make": "node --import tsx scripts/make-eval.ts",
    "media:demo": "bash scripts/make-demo-gif.sh",
    "media:cover": "bash scripts/make-cover.sh",
    "media:chart": "bash scripts/make-chart.sh",
    "media:zee": "node --import tsx scripts/record-zee.ts"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.1",
    "@types/node": "^22.10.0",
    "three": "0.186.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@mastra/core": "1.74.0",
    "@sentry/node": "11.4.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  }
}
