# Dropzone Zero configuration.
# Copy to .env and fill in. Real user files never leave this machine;
# cloud services below only receive sample data or aggregate counts.

# Folder to watch and organize
DZ_INBOX=~/Downloads

# Local model (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
DZ_MODEL=gemma4:e4b

# Temporal (local dev server by default)
TEMPORAL_ADDRESS=127.0.0.1:7233

# Review gate: local TabPFN v2 through uv, no account or token needed ("off" to skip)
DZ_REVIEW_GATE=on

# Allowed new files above this count need your OK, even in `dz watch --auto`
DZ_BULK_LIMIT=20

# Desktop notifications from `dz watch` (macOS); "off" to silence
DZ_NOTIFY=on

# Tinker (Thinking Machines) - fine-tuning on sample data only
TINKER_API_KEY=

# Auth0 remote approval (optional). Zee's questions also go to your phone as an
# Auth0 Guardian push (CIBA), so you can approve while away from the Mac. The push
# says only what kind of move it is ("move 1 installer"), never a file name.
# Leave AUTH0_DOMAIN empty to keep approvals in Zee only.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# The Auth0 user who approves (User Management > Users), e.g. auth0|123abc
AUTH0_APPROVER_USER_ID=

# Sentry - aggregate traces only, file names and contents are scrubbed
SENTRY_DSN=

# ElevenLabs - voice summary of counts only, no file names
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
