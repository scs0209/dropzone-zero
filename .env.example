# Dropzone Zero configuration.
# Copy to .env and fill in. Real user files never leave this machine;
# cloud services below only receive sample data or aggregate counts.

# Folder to watch and organize
DZ_INBOX=~/Downloads

# Local model (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
DZ_MODEL=gemma4:e4b

# Temporal (local dev server by default)
TEMPORAL_ADDRESS=127.0.0.1:7233

# TabPFN (Prior Labs)
TABPFN_TOKEN=

# Tinker (Thinking Machines) - fine-tuning on sample data only
TINKER_API_KEY=

# Backboard - model comparison on sample data only
BACKBOARD_API_KEY=

# Sentry - aggregate traces only, file names and contents are scrubbed
SENTRY_DSN=

# Auth0 for AI Agents - approval before bulk moves (web dashboard)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ElevenLabs - voice summary of counts only, no file names
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
